<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/base.xml"/>
    <springProperty scope="context" name="application_name" source="spring.application.name" defaultValue="optracard-backend"/>
    <springProperty scope="context" name="loki_url" source="loki.url" defaultValue="http://localhost:3100/loki/api/v1/push"/>

    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>${loki_url}</url>
        </http>
        <labels>
            app = ${application_name}
            service_name = ${application_name}
            host = ${HOSTNAME}
            level = %level
        </labels>
        <format>
            <message>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId:-none}-%X{spanId:-none}] %-5level %logger{36} - %msg%n</pattern>
            </message>
            <sortByTime>true</sortByTime>
        </format>
        <batchSize>100</batchSize>
        <batchTimeoutMs>100</batchTimeoutMs>
    </appender>

    <root level="INFO">
        <appender-ref ref="LOKI"/>
    </root>
</configuration>

